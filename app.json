{
  "expo": {
    "name": "NoteVoice",
    "slug": "whisp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notevoice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.notevoice.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NoteVoice needs microphone access to record voice notes.",
        "NSCameraUsageDescription": "NoteVoice needs camera access to attach photos to notes.",
        "NSPhotoLibraryUsageDescription": "NoteVoice needs photo library access to attach images.",
        "NSPhotoLibraryAddUsageDescription": "NoteVoice needs permission to save images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.notevoice.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5e6ad2"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "NoteVoice needs microphone access to record voice notes."
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "groqKey": "process.env.EXPO_PUBLIC_GROQ_API_KEY",
      "router": {},
      "eas": {
        "projectId": "5490a919-41e0-4f1d-b8e3-166bdf73c32c"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "subhadip95"
  }
}
